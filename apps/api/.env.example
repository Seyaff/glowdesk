PORT=4000
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/buildonyx

# Which LLM to use for chat: gemini | groq  (swap with one line)
LLM_PROVIDER=groq

# Gemini (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Check current model names in Google's docs before running
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Groq (free tier) — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Search: none = keyword search, no key needed (default) | gemini = vector embeddings (needs GEMINI_API_KEY)
EMBED_PROVIDER=none

# Vector search (only if EMBED_PROVIDER=gemini): local (cosine in Node, zero setup) | atlas (needs Atlas vector index, see README)
VECTOR_SEARCH=local

# Crawler limits
CRAWL_MAX_PAGES=25

# Lead email notifications (SIY-9). Optional: if unset, leads are still saved, just not emailed.
# GMAIL_APP_PASSWORD must be a Google App Password (16 chars, needs 2-Step Verification on):
# https://myaccount.google.com/apppasswords — your normal Gmail password will NOT work.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Admin key (SIY-26) — REQUIRED, the server refuses to start without it.
# Sent as the "x-admin-key" header to POST /clients, POST /clients/:slug/ingest and /leads.
# Use a long random string, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_KEY=

# Lead emails via Brevo HTTP API (recommended on Render free — it blocks SMTP ports 25/465/587).
# Free at https://www.brevo.com → SMTP & API → API Keys. If set, it's used instead of Gmail SMTP.
BREVO_API_KEY=
# Sender address; must be verified in Brevo (Senders & IPs → Senders). Defaults to GMAIL_USER.
MAIL_FROM=
